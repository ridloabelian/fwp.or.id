---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { financialPublications } from '../data/publications';
import { regulationsList } from '../data/regulations';
import { members, aboutData } from '../data/about';

const regionCountsMap = new Map<string, number>();
for (const member of members) {
  const region = member.region || 'Lainnya';
  regionCountsMap.set(region, (regionCountsMap.get(region) ?? 0) + 1);
}

const regionBreakdown = [...regionCountsMap.entries()]
  .map(([region, count]) => ({
    region,
    count,
    percent: Math.round((count / members.length) * 100),
  }))
  .sort((a, b) => b.count - a.count);
---

<BaseLayout
  title="Transparansi, Publikasi Audit &amp; Regulasi Wakaf"
  description="Arsip keterbukaan laporan keuangan wakaf produktif, kompilasi regulasi perwakafan nasional, dan sebaran geografis 49 nazhir anggota FWP."
  breadcrumbs={[
    { name: 'Beranda', url: 'https://fwp.or.id/' },
    { name: 'Transparansi', url: 'https://fwp.or.id/transparansi' },
  ]}
>
  <PageHero
    eyebrow="Akuntabilitas &amp; Tata Kelola"
    title="Transparansi &amp; Regulasi Wakaf"
    description="Komitmen akuntabilitas pengelolaan dana publik, landasan hukum perwakafan nasional, serta pemetaan distribusi lembaga nazhir anggota FWP."
    breadcrumbs={[{ label: 'Transparansi' }]}
    compact={true}
  />

  <section class="section">
    <div class="container">
      <!-- Financial Publications -->
      <div class="section-heading--left" style="margin-bottom: 24px;">
        <div class="eyebrow-pill">Pelaporan Berkala</div>
        <h2>Publikasi &amp; Laporan Keuangan</h2>
        <p>Dokumen pelaporan keuangan dan distribusi kemaslahatan wakaf produktif.</p>
      </div>

      <div class="grid-3" style="margin-bottom: 64px;">
        {financialPublications.map((doc) => {
          const requestHref = `mailto:${aboutData.contact.email}?subject=${encodeURIComponent(
            `Permohonan Akses Salinan: ${doc.title}`,
          )}`;
          return (
            <article class="fwp-card" style="display: flex; flex-direction: column; justify-content: space-between;">
              <div>
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px;">
                  <span class="news-badge" style="margin-bottom: 0;">Tahun {doc.year}</span>
                  <span style="font-size: 0.78rem; color: var(--ink-muted); font-weight: 600;">
                    {doc.size}
                  </span>
                </div>
                <h3 style="font-size: 1.15rem; margin-bottom: 8px;">{doc.title}</h3>
                <p style="font-size: 0.84rem; color: var(--ink-muted); margin-bottom: 16px;">
                  Sumber: {doc.source} &bull; Diperbarui {doc.lastUpdated}
                </p>
              </div>

              {doc.fileUrl ? (
                <a
                  href={doc.fileUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-primary btn-sm"
                >
                  Unduh Dokumen PDF
                </a>
              ) : (
                <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; padding-top: 12px; border-top: 1px solid var(--surface-mist);">
                  <span class="badge-soon" style="margin-left: 0;">Arsip Segera Tersedia</span>
                  <a href={requestHref} class="news-card__read" style="font-size: 0.84rem;">
                    Minta via Sekretariat &rarr;
                  </a>
                </div>
              )}
            </article>
          );
        })}
      </div>

      <!-- Regional Breakdown of 49 Nazhir -->
      <div class="fwp-card" style="margin-bottom: 64px; padding: clamp(24px, 4vw, 36px);">
        <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 24px;">
          <div>
            <div class="eyebrow-pill eyebrow-pill--cyan" style="margin-bottom: 10px;">
              Pemetaan Keanggotaan
            </div>
            <h2 style="margin-bottom: 6px;">
              Sebaran Wilayah {members.length} Nazhir Wakaf Uang Resmi
            </h2>
            <p style="margin-bottom: 0; font-size: 0.94rem;">
              Distribusi domisili kelembagaan anggota FWP per provinsi berdasarkan data STBPN Badan Wakaf Indonesia.
            </p>
          </div>
          <a href="/pusat-nazhir" class="btn btn-outline btn-sm">
            Buka Direktori Lengkap &rarr;
          </a>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
          {regionBreakdown.map((item) => (
            <div style="padding: 14px 16px; border-radius: var(--radius-md); background: var(--surface-canvas); border: 1px solid var(--border-subtle);">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <span style="font-weight: 700; color: var(--navy-900); font-size: 0.92rem;">
                  {item.region}
                </span>
                <span style="font-weight: 800; color: var(--green-700); font-size: 0.86rem;">
                  {item.count} Lembaga ({item.percent}%)
                </span>
              </div>
              <div style="width: 100%; height: 8px; border-radius: var(--radius-full); background: var(--surface-mist); overflow: hidden;">
                <div style={`width: ${Math.max(item.percent, 6)}%; height: 100%; background: linear-gradient(90deg, var(--green-500), var(--cyan-500)); border-radius: var(--radius-full);`} />
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Regulations -->
      <div class="section-heading--left" style="margin-bottom: 24px;">
        <div class="eyebrow-pill">Payung Hukum Perwakafan</div>
        <h2>Regulasi &amp; Standar Kepatuhan Syariah</h2>
        <p>Kerangka hukum nasional yang menjadi rujukan pengelolaan wakaf uang dan aset wakaf produktif di Indonesia.</p>
      </div>

      <div class="grid-2">
        {regulationsList.map((reg) => (
          <article class="fwp-card">
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 10px;">
              <span class="news-badge" style="margin-bottom: 0;">{reg.type}</span>
              <span style="font-size: 0.78rem; color: var(--ink-muted);">Terbit {reg.lastUpdated}</span>
            </div>
            <h3 style="font-size: 1.15rem; margin-bottom: 8px;">{reg.title}</h3>
            <p style="font-size: 0.94rem; margin-bottom: 10px;">{reg.desc}</p>
            <div style="font-size: 0.8rem; color: var(--ink-muted);">
              Otoritas Penerbit: {reg.source}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
